---
// Strona artykułu bloga — SSR z API backendu.
// Odwzorowanie frontend/src/pages/ArticlePage.tsx.
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import { getArticle } from "../../lib/api";
import { cleanWordPressContent } from "../../lib/cleanContent";

const { categorySlug = "", articleSlug = "" } = Astro.params;
const article = await getArticle(categorySlug, articleSlug);

if (!article) {
  Astro.response.status = 404;
}

const title = article
  ? `${article.metaTitle || article.title} | Interpunkcja.com.pl`
  : "Artykuł nie został znaleziony | Interpunkcja.com.pl";
const description = article
  ? article.metaDescription || article.excerpt || article.title
  : "Artykuł nie został znaleziony.";

// Ramka „praca dyplomowa” w środku artykułu - przed drugim nagłówkiem H2
// (czytelnik, który doszedł do połowy, jest najbardziej zaangażowany);
// przy krótszych tekstach na końcu treści
const THESIS_BOX = `<aside class="not-prose my-8 rounded-xl border-2 border-blue-200 dark:border-blue-900 bg-blue-50 dark:bg-blue-950/40 p-5">
  <p class="font-bold text-gray-900 dark:text-white mb-1">Piszesz pracę licencjacką albo magisterską?</p>
  <p class="text-base text-gray-700 dark:text-gray-300 mb-3">Sprawdzimy przecinki, ortografię i przypisy w całym pliku .docx. Każda poprawka trafi do Worda jako zmiana śledzona, z komentarzem i regułą.</p>
  <a href="/korekta-pracy-dyplomowej" data-cta="srodek" class="inline-block px-5 py-2 rounded-lg bg-blue-600 font-semibold hover:bg-blue-700" style="color:#fff;text-decoration:none">Zobacz bezpłatną próbkę 2 stron →</a>
</aside>`;

function withThesisBox(html: string): string {
  const h2 = [...html.matchAll(/<h2[\s>]/gi)];
  if (h2.length >= 2) {
    const at = h2[1].index!;
    return html.slice(0, at) + THESIS_BOX + html.slice(at);
  }
  return html + THESIS_BOX;
}

const cleanedContent = article ? withThesisBox(cleanWordPressContent(article.content)) : "";

function formatDate(iso: string) {
  return new Date(iso).toLocaleDateString("pl-PL", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}
---

<BaseLayout
  title={title}
  description={description}
  canonical={article
    ? `https://www.interpunkcja.com.pl/${article.category.slug}/${article.slug}/`
    : undefined}
  ogType="article"
  robots={article ? "index, follow" : "noindex, nofollow"}
>
  {
    !article ? (
      <div class="max-w-4xl mx-auto px-4 py-12">
        <div class="text-center">
          <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">
            Artykuł nie został znaleziony
          </h1>
          <a href="/" class="text-blue-600 hover:underline">
            Wróć na stronę główną
          </a>
        </div>
      </div>
    ) : (
      <div class="max-w-4xl mx-auto px-4 py-8">
        <nav class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400 mb-6 flex-wrap">
          <a href="/" class="hover:text-blue-600 transition-colors">
            Strona główna
          </a>
          <svg
            class="w-4 h-4 flex-shrink-0"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="m9 18 6-6-6-6" />
          </svg>
          <a
            href={`/category/${article.category.slug}/`}
            class="hover:text-blue-600 transition-colors"
          >
            {article.category.name}
          </a>
          <svg
            class="w-4 h-4 flex-shrink-0"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="m9 18 6-6-6-6" />
          </svg>
          <span class="text-gray-900 dark:text-white line-clamp-1">
            {article.title}
          </span>
        </nav>

        <article class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 overflow-hidden">
          <div class="p-6 md:p-10">
            <a
              href={`/category/${article.category.slug}/`}
              class="inline-block px-3 py-1 bg-blue-100 dark:bg-blue-900/50 text-blue-700 dark:text-blue-300 text-sm font-medium rounded-full mb-4 hover:bg-blue-200 dark:hover:bg-blue-900/70 transition-colors"
            >
              {article.category.name}
            </a>

            <h1 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4 leading-tight">
              {article.title}
            </h1>

            {article.publishedAt && (
              <div class="flex items-center gap-2 text-gray-500 dark:text-gray-400 text-sm mb-8 pb-8 border-b border-gray-200 dark:border-gray-700">
                <svg
                  class="w-4 h-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M8 2v4" />
                  <path d="M16 2v4" />
                  <rect width="18" height="18" x="3" y="4" rx="2" />
                  <path d="M3 10h18" />
                </svg>
                <time datetime={article.publishedAt}>
                  {formatDate(article.publishedAt)}
                </time>
              </div>
            )}

            <div
              class="article-content text-gray-700 dark:text-gray-300 text-lg leading-relaxed
                [&>p]:mb-4
                [&>ul]:list-disc [&>ul]:pl-6 [&>ul]:my-4 [&>ul]:space-y-2
                [&>ol]:list-decimal [&>ol]:pl-6 [&>ol]:my-4 [&>ol]:space-y-2
                [&_li]:pl-1
                [&_a]:text-blue-600 [&_a]:underline [&_a:hover]:text-blue-800
                [&_blockquote]:border-l-4 [&_blockquote]:border-blue-500 [&_blockquote]:pl-4 [&_blockquote]:italic [&_blockquote]:my-4 [&_blockquote]:text-gray-600 dark:[&_blockquote]:text-gray-400
                [&_table]:block [&_table]:overflow-x-auto [&_table]:my-6 [&_table]:text-base [&_table]:border-collapse
                [&_th]:text-left [&_th]:font-semibold [&_th]:p-3 [&_th]:border-b-2 [&_th]:border-gray-300 dark:[&_th]:border-gray-600 [&_th]:bg-gray-50 dark:[&_th]:bg-gray-900
                [&_td]:p-3 [&_td]:text-left [&_td]:align-top [&_td]:border-b [&_td]:border-gray-200 dark:[&_td]:border-gray-700"
              set:html={cleanedContent}
            />
          </div>
        </article>

        <div class="mt-8">
          <a
            href={`/category/${article.category.slug}/`}
            class="inline-flex items-center gap-2 text-blue-600 hover:underline font-medium"
          >
            <svg
              class="w-4 h-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m12 19-7-7 7-7" />
              <path d="M19 12H5" />
            </svg>
            Więcej artykułów z kategorii {article.category.name}
          </a>
        </div>

        <div class="mt-12 grid md:grid-cols-2 gap-4">
          <div class="p-6 rounded-xl bg-gradient-to-r from-blue-600 to-blue-700 text-white">
            <h2 class="text-xl font-bold mb-2">Sprawdź swój tekst</h2>
            <p class="text-blue-100 mb-5">
              Wklej tekst - pisownię sprawdzimy od razu, bez zakładania konta,
              a przecinki z wyjaśnieniem reguły sprawdzi korektor AI.
            </p>
            <a
              href="/sprawdzanie-pisowni"
              data-cta="koniec-tekst"
              class="inline-block px-6 py-3 bg-white text-blue-600 font-semibold rounded-lg hover:bg-blue-50 transition-colors"
            >
              Sprawdź tekst za darmo
            </a>
          </div>
          <div class="p-6 rounded-xl border-2 border-blue-600 bg-white dark:bg-gray-800">
            <h2 class="text-xl font-bold text-gray-900 dark:text-white mb-2">Cała praca dyplomowa</h2>
            <p class="text-gray-600 dark:text-gray-400 mb-5">
              Wgraj plik .docx i dostań poprawki w trybie śledzenia zmian Worda.
              Najpierw bezpłatna próbka 2 stron, potem od 39 zł.
            </p>
            <a
              href="/korekta-pracy-dyplomowej"
              data-cta="koniec-praca"
              class="inline-block px-6 py-3 bg-blue-600 text-white font-semibold rounded-lg hover:bg-blue-700 transition-colors"
            >
              Korekta pracy dyplomowej
            </a>
          </div>
        </div>
      </div>
    )
  }
  <script is:inline>
    // Kliknięcia w wezwania do działania w artykułach -> GA4 (send_to jak w SPA)
    document.addEventListener("click", function (e) {
      var a = e.target && e.target.closest && e.target.closest("[data-cta]");
      if (!a) return;
      window.dataLayer = window.dataLayer || [];
      (function () { window.dataLayer.push(arguments); })("event", "article_cta", {
        placement: a.getAttribute("data-cta"),
        article: location.pathname,
        send_to: "G-RYR505E30R",
      });
    });
  </script>
</BaseLayout>
