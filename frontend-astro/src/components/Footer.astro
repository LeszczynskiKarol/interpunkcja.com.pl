---
// Stopka publicznego frontu — odwzorowanie frontend/src/components/Footer.tsx.
const tools = [
  { name: "Sprawdzanie ortografii", path: "/sprawdzanie-ortografii" },
  { name: "Sprawdzanie pisowni", path: "/sprawdzanie-pisowni" },
  { name: "Korektor tekstu", path: "/korektor-tekstu" },
  { name: "Poprawianie błędów", path: "/poprawianie-bledow" },
  { name: "Korekta online", path: "/korekta-tekstu-online" },
];

const year = new Date().getFullYear();
---

<footer
  class="bg-gray-100 dark:bg-gray-900 border-t border-gray-200 dark:border-gray-800 transition-colors"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-8">
      <!-- Logo & Description -->
      <div class="lg:col-span-2">
        <a href="/" class="flex items-center gap-2 mb-4">
          <span class="text-2xl">✏️</span>
          <div class="flex flex-col">
            <span class="font-bold text-xl text-gray-900 dark:text-white">
              Interpunkcja<span class="text-blue-600">.com.pl</span>
            </span>
            <span
              class="text-[10px] text-gray-500 dark:text-gray-400 tracking-wide uppercase"
            >
              Sprawdzanie pisowni online
            </span>
          </div>
        </a>
        <p class="text-sm text-gray-600 dark:text-gray-400 mb-4 max-w-sm">
          Sprawdź interpunkcję, ortografię i pisownię w swoim tekście za pomocą
          sztucznej inteligencji Claude. Profesjonalny korektor tekstów online.
        </p>
        <div
          class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400"
        >
          <svg
            class="w-4 h-4 text-blue-500"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            ><path
              d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"
            ></path></svg
          >
          <span>Powered by Claude AI</span>
        </div>
      </div>

      <!-- Narzędzia - Landing Pages -->
      <div>
        <h3
          class="font-semibold text-gray-900 dark:text-white mb-4 flex items-center gap-2"
        >
          <span class="w-1.5 h-1.5 bg-blue-600 rounded-full"></span>
          Narzędzia
        </h3>
        <ul class="space-y-2.5 text-sm">
          {
            tools.map((tool) => (
              <li>
                <a
                  href={tool.path}
                  class="group flex flex-col text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
                >
                  <span class="font-medium">{tool.name}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <!-- Serwis -->
      <div>
        <h3
          class="font-semibold text-gray-900 dark:text-white mb-4 flex items-center gap-2"
        >
          <span class="w-1.5 h-1.5 bg-green-600 rounded-full"></span>
          Serwis
        </h3>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a
              href="/"
              class="text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
            >
              Strona główna
            </a>
          </li>
          <li>
            <a
              href="/cennik"
              class="text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
            >
              Cennik
            </a>
          </li>
          <li>
            <a
              href="/partnerzy"
              class="text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
            >
              Partnerzy
            </a>
          </li>
          <li>
            <a
              href="/logowanie"
              class="text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
            >
              Logowanie
            </a>
          </li>
          <li>
            <a
              href="/rejestracja"
              class="text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
            >
              Załóż konto
            </a>
          </li>
        </ul>
      </div>

      <!-- Informacje prawne -->
      <div>
        <h3
          class="font-semibold text-gray-900 dark:text-white mb-4 flex items-center gap-2"
        >
          <span class="w-1.5 h-1.5 bg-purple-600 rounded-full"></span>
          Informacje
        </h3>
        <ul class="space-y-2.5 text-sm">
          <li>
            <a
              href="/regulamin"
              class="text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
            >
              Regulamin
            </a>
          </li>
          <li>
            <a
              href="/polityka-prywatnosci"
              class="text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
            >
              Polityka prywatności
            </a>
          </li>
          <li>
            <a
              href="/polityka-cookies"
              class="text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
            >
              Polityka cookies
            </a>
          </li>
          <li>
            <button
              id="cookie-settings-btn"
              class="flex items-center gap-1.5 text-gray-600 dark:text-gray-400 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
            >
              <svg
                class="w-4 h-4"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                ><path
                  d="M12 2a10 10 0 1 0 10 10 4 4 0 0 1-5-5 4 4 0 0 1-5-5"
                ></path><path d="M8.5 8.5v.01"></path><path d="M16 15.5v.01"
                ></path><path d="M12 12v.01"></path><path d="M11 17v.01"
                ></path><path d="M7 14v.01"></path></svg
              >
              Ustawienia cookies
            </button>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom bar -->
    <div class="mt-10 pt-8 border-t border-gray-200 dark:border-gray-800">
      <div
        class="flex flex-col md:flex-row items-center justify-between gap-4"
      >
        <p
          class="text-sm text-gray-500 dark:text-gray-400 text-center md:text-left"
        >
          © {year} Interpunkcja.com.pl. Wszelkie prawa zastrzeżone.
        </p>
        <div
          class="flex items-center gap-4 text-sm text-gray-500 dark:text-gray-400"
        >
          <span>Projekt i wykonanie:</span>
          <a
            href="https://www.karol-leszczynski.pl/"
            target="_blank"
            rel="author"
            class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors font-medium"
          >
            Karol Leszczyński
          </a>
          <span class="text-gray-300 dark:text-gray-600">|</span>
          <a
            href="https://smart-copy.ai"
            target="_blank"
            rel="noopener noreferrer"
            class="hover:text-blue-600 dark:hover:text-blue-400 transition-colors font-medium"
          >
            Smart-Copy.ai
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>

<script is:inline>
  var cookieSettingsBtn = document.getElementById("cookie-settings-btn");
  if (cookieSettingsBtn) {
    cookieSettingsBtn.addEventListener("click", function () {
      window.dispatchEvent(new CustomEvent("open-cookie-settings"));
    });
  }
</script>
