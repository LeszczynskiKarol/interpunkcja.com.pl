---
// Strona kategorii bloga — SSR z API backendu.
// Odwzorowanie frontend/src/pages/CategoryPage.tsx.
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCategory } from "../../lib/api";

const { slug = "" } = Astro.params;
const category = await getCategory(slug);

// Paginacja: ?strona=N (backend zwraca pełną listę artykułów kategorii,
// tniemy ją serwerowo — wolumeny są małe, dodatkowy request niepotrzebny)
const PAGE_SIZE = 12;
const rawPage = Number(Astro.url.searchParams.get("strona") || "1");
const totalArticles = category ? category.articles.length : 0;
const totalPages = Math.max(1, Math.ceil(totalArticles / PAGE_SIZE));
const page =
  Number.isInteger(rawPage) && rawPage >= 1 && rawPage <= totalPages
    ? rawPage
    : null;
const pageArticles = category && page
  ? category.articles.slice((page - 1) * PAGE_SIZE, page * PAGE_SIZE)
  : [];

if (!category || !page) {
  Astro.response.status = 404;
}

function pageUrl(p: number) {
  return p === 1 ? `/category/${slug}/` : `/category/${slug}/?strona=${p}`;
}

// Skrócona lista numerów stron: 1 … (p-1) p (p+1) … N
const pageItems: Array<number | "..."> = [];
if (page) {
  for (let p = 1; p <= totalPages; p++) {
    if (p === 1 || p === totalPages || Math.abs(p - page) <= 1) {
      pageItems.push(p);
    } else if (pageItems[pageItems.length - 1] !== "...") {
      pageItems.push("...");
    }
  }
}

const categoryTitles: Record<string, string> = {
  "interpunkcyjny-slownik-wyrazow": "Interpunkcyjny słownik wyrazów",
  "znaki-interpunkcyjne": "Znaki interpunkcyjne",
  "ogolne-zasady-interpunkcji": "Ogólne zasady interpunkcji",
};

const categoryDescriptions: Record<string, string> = {
  "interpunkcyjny-slownik-wyrazow":
    'Sprawdź zasady użycia przecinka przed konkretnymi słowami. Czy stawiamy przecinek przed "że", "który", "gdy" i innymi?',
  "znaki-interpunkcyjne":
    "Poznaj funkcje i zasady stosowania poszczególnych znaków interpunkcyjnych: przecinka, myślnika, cudzysłowu i innych.",
  "ogolne-zasady-interpunkcji":
    "Ogólne zasady interpunkcji polskiej. Dowiedz się, jak poprawnie używać znaków interpunkcyjnych w zdaniach złożonych.",
};

const pageSuffix = page && page > 1 ? ` – strona ${page}` : "";
const title = category
  ? `${categoryTitles[category.slug] || category.name}${pageSuffix} | Interpunkcja.com.pl`
  : "Kategoria nie została znaleziona | Interpunkcja.com.pl";
const description = category
  ? categoryDescriptions[category.slug] ||
    category.description ||
    `Artykuły z kategorii ${category.name}`
  : "Kategoria nie została znaleziona.";

function formatDate(iso: string) {
  return new Date(iso).toLocaleDateString("pl-PL", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}
---

<BaseLayout
  title={title}
  description={description}
  canonical={category && page
    ? `https://www.interpunkcja.com.pl${pageUrl(page)}`
    : undefined}
  robots={category && page ? "index, follow" : "noindex, nofollow"}
>
  {
    !category || !page ? (
      <div class="max-w-4xl mx-auto px-4 py-12">
        <div class="text-center">
          <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">
            {category ? "Strona nie została znaleziona" : "Kategoria nie została znaleziona"}
          </h1>
          <a href="/" class="text-blue-600 hover:underline">
            Wróć na stronę główną
          </a>
        </div>
      </div>
    ) : (
      <div class="max-w-4xl mx-auto px-4 py-8">
        <nav class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400 mb-6">
          <a href="/" class="hover:text-blue-600">
            Strona główna
          </a>
          <svg
            class="w-4 h-4"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="m9 18 6-6-6-6" />
          </svg>
          <span class="text-gray-900 dark:text-white">
            {categoryTitles[category.slug] || category.name}
          </span>
        </nav>

        <div class="mb-8">
          <h1 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4">
            {categoryTitles[category.slug] || category.name}
          </h1>
          {(categoryDescriptions[category.slug] || category.description) && (
            <p class="text-lg text-gray-600 dark:text-gray-400">
              {categoryDescriptions[category.slug] || category.description}
            </p>
          )}
        </div>

        {category.articles.length === 0 ? (
          <div class="text-center py-12 bg-gray-50 dark:bg-gray-800/50 rounded-xl">
            <svg
              class="w-12 h-12 text-gray-400 mx-auto mb-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" />
              <path d="M14 2v4a2 2 0 0 0 2 2h4" />
              <path d="M10 9H8" />
              <path d="M16 13H8" />
              <path d="M16 17H8" />
            </svg>
            <p class="text-gray-500 dark:text-gray-400">
              Brak artykułów w tej kategorii
            </p>
          </div>
        ) : (
          <div class="space-y-4">
            {pageArticles.map((article) => (
              <a
                href={`/${category.slug}/${article.slug}/`}
                class="block bg-white dark:bg-gray-800 rounded-xl p-6 border border-gray-200 dark:border-gray-700 hover:border-blue-500 dark:hover:border-blue-400 hover:shadow-md transition-all group"
              >
                <h2 class="text-xl font-semibold text-gray-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 mb-2">
                  {article.title}
                </h2>
                {article.excerpt && (
                  <p class="text-gray-600 dark:text-gray-400 mb-3 line-clamp-2">
                    {article.excerpt}
                  </p>
                )}
                {article.publishedAt && (
                  <div class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-500">
                    <svg
                      class="w-4 h-4"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M8 2v4" />
                      <path d="M16 2v4" />
                      <rect width="18" height="18" x="3" y="4" rx="2" />
                      <path d="M3 10h18" />
                    </svg>
                    <time datetime={article.publishedAt}>
                      {formatDate(article.publishedAt)}
                    </time>
                  </div>
                )}
              </a>
            ))}
          </div>
        )}

        {totalPages > 1 && (
          <nav
            class="mt-10 flex items-center justify-center gap-2 flex-wrap"
            aria-label="Paginacja"
          >
            {page > 1 && (
              <a
                href={pageUrl(page - 1)}
                class="px-4 py-2 rounded-lg border border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-300 hover:border-blue-500 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
              >
                ← Poprzednia
              </a>
            )}
            {pageItems.map((item) =>
              item === "..." ? (
                <span class="px-2 text-gray-400 dark:text-gray-500">…</span>
              ) : item === page ? (
                <span
                  class="px-4 py-2 rounded-lg bg-blue-600 text-white font-medium"
                  aria-current="page"
                >
                  {item}
                </span>
              ) : (
                <a
                  href={pageUrl(item)}
                  class="px-4 py-2 rounded-lg border border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-300 hover:border-blue-500 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
                >
                  {item}
                </a>
              )
            )}
            {page < totalPages && (
              <a
                href={pageUrl(page + 1)}
                class="px-4 py-2 rounded-lg border border-gray-200 dark:border-gray-700 text-gray-600 dark:text-gray-300 hover:border-blue-500 hover:text-blue-600 dark:hover:text-blue-400 transition-colors"
              >
                Następna →
              </a>
            )}
          </nav>
        )}

        <div class="mt-12 p-6 bg-gradient-to-r from-blue-600 to-blue-700 rounded-xl text-white text-center">
          <h2 class="text-xl font-bold mb-2">
            Sprawdź interpunkcję swojego tekstu
          </h2>
          <p class="text-blue-100 mb-4">
            Skorzystaj z naszego narzędzia do automatycznego sprawdzania
            przecinków i innych znaków interpunkcyjnych.
          </p>
          <a
            href="/panel"
            class="inline-block px-6 py-3 bg-white text-blue-600 font-semibold rounded-lg hover:bg-blue-50 transition-colors"
          >
            Sprawdź tekst za darmo
          </a>
        </div>
      </div>
    )
  }
</BaseLayout>
