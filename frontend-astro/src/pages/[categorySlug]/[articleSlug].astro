---
// Strona artykułu bloga — SSR z API backendu.
// Odwzorowanie frontend/src/pages/ArticlePage.tsx.
export const prerender = false;

import BaseLayout from "../../layouts/BaseLayout.astro";
import { getArticle } from "../../lib/api";
import { cleanWordPressContent } from "../../lib/cleanContent";

const { categorySlug = "", articleSlug = "" } = Astro.params;
const article = await getArticle(categorySlug, articleSlug);

if (!article) {
  Astro.response.status = 404;
}

const title = article
  ? `${article.metaTitle || article.title} | Interpunkcja.com.pl`
  : "Artykuł nie został znaleziony | Interpunkcja.com.pl";
const description = article
  ? article.metaDescription || article.excerpt || article.title
  : "Artykuł nie został znaleziony.";

const cleanedContent = article ? cleanWordPressContent(article.content) : "";

function formatDate(iso: string) {
  return new Date(iso).toLocaleDateString("pl-PL", {
    year: "numeric",
    month: "long",
    day: "numeric",
  });
}
---

<BaseLayout
  title={title}
  description={description}
  canonical={article
    ? `https://www.interpunkcja.com.pl/${article.category.slug}/${article.slug}/`
    : undefined}
  ogType="article"
  robots={article ? "index, follow" : "noindex, nofollow"}
>
  {
    !article ? (
      <div class="max-w-4xl mx-auto px-4 py-12">
        <div class="text-center">
          <h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">
            Artykuł nie został znaleziony
          </h1>
          <a href="/" class="text-blue-600 hover:underline">
            Wróć na stronę główną
          </a>
        </div>
      </div>
    ) : (
      <div class="max-w-4xl mx-auto px-4 py-8">
        <nav class="flex items-center gap-2 text-sm text-gray-500 dark:text-gray-400 mb-6 flex-wrap">
          <a href="/" class="hover:text-blue-600 transition-colors">
            Strona główna
          </a>
          <svg
            class="w-4 h-4 flex-shrink-0"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="m9 18 6-6-6-6" />
          </svg>
          <a
            href={`/category/${article.category.slug}/`}
            class="hover:text-blue-600 transition-colors"
          >
            {article.category.name}
          </a>
          <svg
            class="w-4 h-4 flex-shrink-0"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="m9 18 6-6-6-6" />
          </svg>
          <span class="text-gray-900 dark:text-white line-clamp-1">
            {article.title}
          </span>
        </nav>

        <article class="bg-white dark:bg-gray-800 rounded-xl shadow-sm border border-gray-200 dark:border-gray-700 overflow-hidden">
          <div class="p-6 md:p-10">
            <a
              href={`/category/${article.category.slug}/`}
              class="inline-block px-3 py-1 bg-blue-100 dark:bg-blue-900/50 text-blue-700 dark:text-blue-300 text-sm font-medium rounded-full mb-4 hover:bg-blue-200 dark:hover:bg-blue-900/70 transition-colors"
            >
              {article.category.name}
            </a>

            <h1 class="text-3xl md:text-4xl font-bold text-gray-900 dark:text-white mb-4 leading-tight">
              {article.title}
            </h1>

            {article.publishedAt && (
              <div class="flex items-center gap-2 text-gray-500 dark:text-gray-400 text-sm mb-8 pb-8 border-b border-gray-200 dark:border-gray-700">
                <svg
                  class="w-4 h-4"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M8 2v4" />
                  <path d="M16 2v4" />
                  <rect width="18" height="18" x="3" y="4" rx="2" />
                  <path d="M3 10h18" />
                </svg>
                <time datetime={article.publishedAt}>
                  {formatDate(article.publishedAt)}
                </time>
              </div>
            )}

            <div
              class="article-content text-gray-700 dark:text-gray-300 text-lg leading-relaxed
                [&>p]:mb-4
                [&>ul]:list-disc [&>ul]:pl-6 [&>ul]:my-4 [&>ul]:space-y-2
                [&>ol]:list-decimal [&>ol]:pl-6 [&>ol]:my-4 [&>ol]:space-y-2
                [&_li]:pl-1
                [&_a]:text-blue-600 [&_a]:underline [&_a:hover]:text-blue-800
                [&_blockquote]:border-l-4 [&_blockquote]:border-blue-500 [&_blockquote]:pl-4 [&_blockquote]:italic [&_blockquote]:my-4 [&_blockquote]:text-gray-600 dark:[&_blockquote]:text-gray-400"
              set:html={cleanedContent}
            />
          </div>
        </article>

        <div class="mt-8">
          <a
            href={`/category/${article.category.slug}/`}
            class="inline-flex items-center gap-2 text-blue-600 hover:underline font-medium"
          >
            <svg
              class="w-4 h-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="m12 19-7-7 7-7" />
              <path d="M19 12H5" />
            </svg>
            Więcej artykułów z kategorii {article.category.name}
          </a>
        </div>

        <div class="mt-12 p-8 bg-gradient-to-r from-blue-600 to-blue-700 rounded-xl text-white text-center">
          <h2 class="text-2xl font-bold mb-3">
            Sprawdź interpunkcję swojego tekstu
          </h2>
          <p class="text-blue-100 mb-6 max-w-lg mx-auto">
            Skorzystaj z naszego narzędzia do automatycznego sprawdzania
            przecinków i innych znaków interpunkcyjnych.
          </p>
          <a
            href="/panel"
            class="inline-block px-8 py-3 bg-white text-blue-600 font-semibold rounded-lg hover:bg-blue-50 transition-colors"
          >
            Sprawdź tekst za darmo
          </a>
        </div>
      </div>
    )
  }
</BaseLayout>
