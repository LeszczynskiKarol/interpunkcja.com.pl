---
// Cookie banner — odwzorowanie frontend/src/components/CookieBanner.tsx
// w vanilla JS. Zapis zgody w tym samym kluczu i formacie localStorage
// ("cookie-consent", format zustand persist), więc zgoda działa spójnie
// między frontem publicznym (Astro) a aplikacją (SPA).
---

<div id="cookie-banner-root" class="hidden">
  <!-- Overlay -->
  <div id="cookie-overlay" class="fixed inset-0 bg-black/50 z-[9998]"></div>

  <!-- Banner -->
  <div class="fixed bottom-0 left-0 right-0 z-[9999] p-4 md:p-6">
    <div
      class="max-w-4xl mx-auto bg-white dark:bg-gray-800 rounded-2xl shadow-2xl border border-gray-200 dark:border-gray-700 overflow-hidden"
    >
      <!-- Główny widok -->
      <div id="cookie-main-view" class="p-6">
        <div class="flex items-start gap-4">
          <div
            class="w-12 h-12 bg-blue-100 dark:bg-blue-900/50 rounded-xl flex items-center justify-center flex-shrink-0"
          >
            <svg
              class="w-6 h-6 text-blue-600 dark:text-blue-400"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path d="M12 2a10 10 0 1 0 10 10 4 4 0 0 1-5-5 4 4 0 0 1-5-5"
              ></path><path d="M8.5 8.5v.01"></path><path d="M16 15.5v.01"
              ></path><path d="M12 12v.01"></path><path d="M11 17v.01"
              ></path><path d="M7 14v.01"></path></svg
            >
          </div>
          <div class="flex-1">
            <h3
              class="text-lg font-semibold text-gray-900 dark:text-white mb-2"
            >
              Ta strona używa plików cookies
            </h3>
            <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">
              Używamy plików cookies, aby zapewnić najlepsze doświadczenie na
              naszej stronie, analizować ruch i personalizować treści. Możesz
              zaakceptować wszystkie cookies lub dostosować swoje preferencje.
            </p>
            <div class="flex flex-wrap gap-2 text-sm">
              <a
                href="/polityka-prywatnosci"
                class="text-blue-600 dark:text-blue-400 hover:underline"
              >
                Polityka prywatności
              </a>
              <span class="text-gray-400">•</span>
              <a
                href="/polityka-cookies"
                class="text-blue-600 dark:text-blue-400 hover:underline"
              >
                Polityka cookies
              </a>
            </div>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row gap-3 mt-6">
          <button
            id="cookie-reject-all"
            class="px-6 py-2.5 text-sm font-medium text-gray-700 dark:text-gray-300 bg-gray-100 dark:bg-gray-700 rounded-lg hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors"
          >
            Odrzuć opcjonalne
          </button>
          <button
            id="cookie-open-settings"
            class="px-6 py-2.5 text-sm font-medium text-gray-700 dark:text-gray-300 border border-gray-300 dark:border-gray-600 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors flex items-center justify-center gap-2"
          >
            <svg
              class="w-4 h-4"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path
                d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"
              ></path><circle cx="12" cy="12" r="3"></circle></svg
            >
            Dostosuj
          </button>
          <button
            id="cookie-accept-all"
            class="px-6 py-2.5 text-sm font-medium text-white bg-blue-600 rounded-lg hover:bg-blue-700 transition-colors flex-1 sm:flex-none"
          >
            Zaakceptuj wszystkie
          </button>
        </div>
      </div>

      <!-- Widok ustawień -->
      <div id="cookie-settings-view" class="p-6 hidden">
        <div class="flex items-center justify-between mb-6">
          <h3 class="text-lg font-semibold text-gray-900 dark:text-white">
            Ustawienia cookies
          </h3>
          <button
            id="cookie-close-settings"
            class="p-2 text-gray-500 hover:bg-gray-100 dark:hover:bg-gray-700 rounded-lg"
          >
            <svg
              class="w-5 h-5"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              ><path d="M18 6 6 18"></path><path d="m6 6 12 12"></path></svg
            >
          </button>
        </div>

        <div class="space-y-4">
          <!-- Niezbędne -->
          <div class="p-4 bg-gray-50 dark:bg-gray-700/50 rounded-lg">
            <div class="flex items-center justify-between">
              <div>
                <h4 class="font-medium text-gray-900 dark:text-white">
                  Niezbędne
                </h4>
                <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">
                  Wymagane do działania strony. Nie można ich wyłączyć.
                </p>
              </div>
              <div
                class="w-12 h-6 bg-blue-600 rounded-full flex items-center justify-end px-1"
              >
                <div class="w-4 h-4 bg-white rounded-full"></div>
              </div>
            </div>
          </div>

          <!-- Analityczne -->
          <div class="p-4 bg-gray-50 dark:bg-gray-700/50 rounded-lg">
            <div class="flex items-center justify-between">
              <div>
                <h4 class="font-medium text-gray-900 dark:text-white">
                  Analityczne
                </h4>
                <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">
                  Pomagają nam zrozumieć, jak użytkownicy korzystają ze strony
                  (Google Analytics).
                </p>
              </div>
              <button
                id="cookie-toggle-analytics"
                data-on="false"
                class="w-12 h-6 rounded-full flex items-center px-1 transition-colors bg-gray-300 dark:bg-gray-600 justify-start"
              >
                <div class="w-4 h-4 bg-white rounded-full"></div>
              </button>
            </div>
          </div>

          <!-- Marketingowe -->
          <div class="p-4 bg-gray-50 dark:bg-gray-700/50 rounded-lg">
            <div class="flex items-center justify-between">
              <div>
                <h4 class="font-medium text-gray-900 dark:text-white">
                  Marketingowe
                </h4>
                <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">
                  Służą do personalizacji reklam i śledzenia skuteczności
                  kampanii.
                </p>
              </div>
              <button
                id="cookie-toggle-marketing"
                data-on="false"
                class="w-12 h-6 rounded-full flex items-center px-1 transition-colors bg-gray-300 dark:bg-gray-600 justify-start"
              >
                <div class="w-4 h-4 bg-white rounded-full"></div>
              </button>
            </div>
          </div>
        </div>

        <div class="flex gap-3 mt-6">
          <button
            id="cookie-cancel-settings"
            class="px-6 py-2.5 text-sm font-medium text-gray-700 dark:text-gray-300 border border-gray-300 dark:border-gray-600 rounded-lg hover:bg-gray-50 dark:hover:bg-gray-700 transition-colors"
          >
            Anuluj
          </button>
          <button
            id="cookie-save-settings"
            class="px-6 py-2.5 text-sm font-medium text-white bg-blue-600 rounded-lg hover:bg-blue-700 transition-colors flex-1"
          >
            Zapisz ustawienia
          </button>
        </div>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    var STORAGE_KEY = "cookie-consent";
    var root = document.getElementById("cookie-banner-root");
    var mainView = document.getElementById("cookie-main-view");
    var settingsView = document.getElementById("cookie-settings-view");
    var toggles = {
      analytics: document.getElementById("cookie-toggle-analytics"),
      marketing: document.getElementById("cookie-toggle-marketing"),
    };

    function readConsent() {
      try {
        var stored = JSON.parse(localStorage.getItem(STORAGE_KEY));
        return stored && stored.state ? stored.state.consent : null;
      } catch (e) {
        return null;
      }
    }

    function writeConsent(consent) {
      try {
        localStorage.setItem(
          STORAGE_KEY,
          JSON.stringify({
            state: { consent: consent, showBanner: false },
            version: 0,
          })
        );
      } catch (e) {}
      updateGoogleConsent(consent);
      hide();
    }

    function updateGoogleConsent(consent) {
      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        event: "consent_update",
        consent_analytics: consent.analytics ? "granted" : "denied",
        consent_marketing: consent.marketing ? "granted" : "denied",
      });
      function gtag() {
        window.dataLayer.push(arguments);
      }
      gtag("consent", "update", {
        analytics_storage: consent.analytics ? "granted" : "denied",
        ad_storage: consent.marketing ? "granted" : "denied",
        ad_user_data: consent.marketing ? "granted" : "denied",
        ad_personalization: consent.marketing ? "granted" : "denied",
      });
    }

    function show() {
      var consent = readConsent();
      setToggle("analytics", consent ? consent.analytics : false);
      setToggle("marketing", consent ? consent.marketing : false);
      settingsView.classList.add("hidden");
      mainView.classList.remove("hidden");
      root.classList.remove("hidden");
    }

    function hide() {
      root.classList.add("hidden");
    }

    function setToggle(name, on) {
      var btn = toggles[name];
      btn.setAttribute("data-on", on ? "true" : "false");
      btn.classList.toggle("bg-blue-600", on);
      btn.classList.toggle("justify-end", on);
      btn.classList.toggle("bg-gray-300", !on);
      btn.classList.toggle("dark:bg-gray-600", !on);
      btn.classList.toggle("justify-start", !on);
    }

    // Inicjalizacja: pokaż banner tylko bez zapisanej zgody,
    // przy zapisanej — zaktualizuj Google Consent Mode.
    // Banner pojawia się dopiero po ustabilizowaniu webfontów (ładowanych
    // asynchronicznie) — inaczej reflow tekstu w elemencie fixed-bottom
    // przesuwa całą jego zawartość i podbija CLS.
    var existing = readConsent();
    if (existing) {
      updateGoogleConsent(existing);
    } else {
      var shown = false;
      var showOnce = function () {
        if (!shown) {
          shown = true;
          show();
        }
      };
      setTimeout(function () {
        if (document.fonts && document.fonts.ready) {
          document.fonts.ready.then(showOnce);
        } else {
          showOnce();
        }
      }, 1500);
      setTimeout(showOnce, 3500);
    }

    document
      .getElementById("cookie-accept-all")
      .addEventListener("click", function () {
        writeConsent({ necessary: true, analytics: true, marketing: true });
      });

    document
      .getElementById("cookie-reject-all")
      .addEventListener("click", function () {
        writeConsent({ necessary: true, analytics: false, marketing: false });
      });

    document
      .getElementById("cookie-open-settings")
      .addEventListener("click", function () {
        mainView.classList.add("hidden");
        settingsView.classList.remove("hidden");
      });

    function backToMain() {
      settingsView.classList.add("hidden");
      mainView.classList.remove("hidden");
    }
    document
      .getElementById("cookie-close-settings")
      .addEventListener("click", backToMain);
    document
      .getElementById("cookie-cancel-settings")
      .addEventListener("click", backToMain);

    ["analytics", "marketing"].forEach(function (name) {
      toggles[name].addEventListener("click", function () {
        setToggle(name, toggles[name].getAttribute("data-on") !== "true");
      });
    });

    document
      .getElementById("cookie-save-settings")
      .addEventListener("click", function () {
        writeConsent({
          necessary: true,
          analytics: toggles.analytics.getAttribute("data-on") === "true",
          marketing: toggles.marketing.getAttribute("data-on") === "true",
        });
      });

    document
      .getElementById("cookie-overlay")
      .addEventListener("click", hide);

    // Przycisk "Ustawienia cookies" w stopce
    window.addEventListener("open-cookie-settings", show);
  })();
</script>
